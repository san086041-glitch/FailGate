# 数据库：开发用 SQLite；部署用 PostgreSQL（ADR 0024，启动时自动跑 Alembic 迁移），例如
# FAILGATE_DB_URL=postgresql+asyncpg://failgate:failgate@127.0.0.1:5432/failgate
# 现有的 SQLite 库可以用 `failgate db copy --from … --to …` 搬过去
FAILGATE_DB_URL=sqlite+aiosqlite:///./failgate.db
# 改名前的变量名 WARDEN_DB_URL 仍然有效（两个都设了以 FAILGATE_DB_URL 为准）；
# 老的本地库是 ./warden.db，想继续用就把上面的路径指向它

# GitHub App（创建步骤见 docs/github-app-setup.md）。两项都填了才会真正往 GitHub 写
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# 私钥放在仓库外面，例如 D:/AgentProject/secrets/failgate-dev.pem
GITHUB_APP_PRIVATE_KEY_PATH=
# GitHub Enterprise 才需要改
GITHUB_API_URL=https://api.github.com
# 写操作失败后的补偿重试间隔（秒）
EFFECT_RETRY_INTERVAL_SECONDS=60

# 新接入仓库的默认模式：shadow（只记录）| live | paused
DEFAULT_REPO_MODE=shadow

# 队列（ADR 0023）：events 车道跑分诊 / 查重 / 答疑，sandbox 车道跑复现 / 核验
# local = 进程内（重启丢任务、只能单进程）；redis = arq + Redis（持久化、可拆成多个进程）
QUEUE_BACKEND=local
REDIS_URL=redis://127.0.0.1:6379/0
EVENTS_CONCURRENCY=4
SANDBOX_CONCURRENCY=1
# serve 进程里跑哪几条车道；只在 QUEUE_BACKEND=redis 时生效。
# 留空 = serve 只收 webhook，另起 `failgate worker --lanes events` / `--lanes sandbox`
WORKER_LANES=events,sandbox
EVENTS_JOB_TIMEOUT_SECONDS=600

# 链路追踪（ADR 0025）：none 不导出；console 打到标准输出；otlp 发到 OTLP/HTTP 后端
TRACING_EXPORTER=none
OTEL_SERVICE_NAME=failgate
# 任意 OTel 后端：填 traces 地址和请求头（"k=v,k2=v2"）；本地看可以用 `failgate trace sink`
OTLP_ENDPOINT=
OTLP_HEADERS=
# Langfuse：不填 OTLP_ENDPOINT 时，用这三项拼出 <host>/api/public/otel/v1/traces 和 Basic 认证。
# 区域：https://cloud.langfuse.com（欧洲）、https://us.cloud.langfuse.com、https://jp.cloud.langfuse.com（日本）；
# 也认控制台片段里的 LANGFUSE_BASE_URL
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 是否把 prompt、回答、各步的输入输出放进 span（默认不放：私有仓库的 issue 内容会发到链路后端）
# TRACING_CAPTURE_CONTENT=true 对所有仓库打开；TRACING_CAPTURE_REPOS 只对列出的仓库打开（逗号分隔，* = 全部）
TRACING_CAPTURE_CONTENT=false
TRACING_CAPTURE_REPOS=
# 任务超时同时决定 worker 崩溃后多久重投（超时 + 10 秒）
SANDBOX_JOB_TIMEOUT_SECONDS=1200

# LLM（任意 OpenAI 兼容接口）。未设置 LLM_API_KEY 时能力模块不运行
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_SMALL=deepseek-flash
LLM_MODEL_LARGE=deepseek-flash
LLM_TIMEOUT_SECONDS=60

# 单个 Case 的模型花费上限（美元）
CASE_BUDGET_USD=0.5

# 查重：召回候选数与两档阈值（LLM 分数）
DEDUP_RECALL_K=20
DEDUP_HIGH=0.95
DEDUP_LOW=0.5
# 可选：向量通道（任意 OpenAI 兼容 /embeddings 接口），留空则只用词法 + 堆栈通道。
# 例如硅基流动：EMBED_BASE_URL=https://api.siliconflow.cn/v1  EMBED_MODEL=BAAI/bge-m3（见 ADR 0007）
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# 可选：GitHub 只读 token，回填历史 issue 时提高限额（可用 gh auth token 生成）。
# failgate replay fbpa 查修复提交要用 GraphQL，必须设置
GITHUB_TOKEN=

# 复现沙箱（见 ADR 0008）。DOCKER_BIN 留空时自动查找（含 Windows 上 Docker Desktop 按用户安装的路径）
DOCKER_BIN=
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2
SANDBOX_RUN_TIMEOUT_SECONDS=120
# install 阶段的网络。默认 bridge 可以访问整个互联网；生产环境应换成只放行包源的 egress 代理网络
SANDBOX_INSTALL_NETWORK=bridge
# 每次执行的完整日志和 meta.json 写到这里（已在 .gitignore 中）；环境缓存索引 envcache.json 也在这里
SANDBOX_ARTIFACTS_DIR=./artifacts
# package 模式装好的环境会 commit 成镜像缓存，总大小超过上限时按 LRU 删除（见 ADR 0009）
SANDBOX_ENV_CACHE_GB=20
# PyPI JSON API（确认版本存在）；pip 镜像源留空则用 pip 默认的 PyPI
PYPI_URL=https://pypi.org
PIP_INDEX_URL=
# 复现总开关（见 ADR 0011）：打开后，用 `failgate repo repro owner/name --package 包名` 配置过的仓库里，
# 被分诊为 bug 的 issue 会在流水线里自动复现；声称 fixes #N 的 PR 会用封存的考卷自动核验（ADR 0018）。
# 需要 Docker；PR 核验还需要 GitHub App 有 Pull requests 读写权限（写权限只用来在 PR 下发评论）
# 并订阅 Pull request 事件
REPRO_ENABLED=false
# 复现 Agent（见 ADR 0010）：每个 issue 最多多少次工具调用、多少次提交、花多少钱（美元）
REPRO_MAX_STEPS=40
REPRO_MAX_ATTEMPTS=4
REPRO_BUDGET_USD=0.5
# 考卷强度（见 ADR 0020）：核验第一层通过后，对修复改动过、考卷执行到的行做变异测试，
# 只附在报告里、不改变结论。每个 PR 多建一个带 coverage 的环境，最多跑这么多个变异体
VERIFY_STRENGTH=true
STRENGTH_MAX_MUTANTS=30
# 隐藏考卷（见 ADR 0021）：封存 L2 考卷时自动只根据 issue 出几道变体题（一次 LLM 调用 + 两次沙箱运行），
# 封存不公开，评论里只公布题数和哈希；核验 PR 时一并运行，提示"疑似只迎合了公开考卷"
HIDDEN_EXAM_ENABLED=true
