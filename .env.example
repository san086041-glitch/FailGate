# 数据库（M0 用 SQLite；之后换成 postgresql+asyncpg://...）
WARDEN_DB_URL=sqlite+aiosqlite:///./warden.db

# GitHub App
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# 新接入仓库的默认模式：shadow（只记录）| live | paused
DEFAULT_REPO_MODE=shadow

# LLM（任意 OpenAI 兼容接口）。未设置 LLM_API_KEY 时能力模块不运行
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_SMALL=deepseek-flash
LLM_MODEL_LARGE=deepseek-flash

# 单个 Case 的模型花费上限（美元）
CASE_BUDGET_USD=0.5

# 查重：召回候选数与两档阈值（LLM 分数）
DEDUP_RECALL_K=8
DEDUP_HIGH=0.95
DEDUP_LOW=0.5
# 可选：向量通道（任意 OpenAI 兼容 /embeddings 接口），留空则只用词法 + 堆栈通道
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# 可选：GitHub 只读 token，回填历史 issue 时提高限额（可用 gh auth token 生成）
GITHUB_TOKEN=
