# 数据库（M0 用 SQLite；之后换成 postgresql+asyncpg://...）
WARDEN_DB_URL=sqlite+aiosqlite:///./warden.db

# GitHub App
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# 新接入仓库的默认模式：shadow（只记录）| live | paused
DEFAULT_REPO_MODE=shadow

# LLM（任意 OpenAI 兼容接口）。未设置 LLM_API_KEY 时能力模块不运行
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_SMALL=deepseek-flash
LLM_MODEL_LARGE=deepseek-flash

# 单个 Case 的模型花费上限（美元）
CASE_BUDGET_USD=0.5
